
# ── LLM (Ollama / vLLM OpenAI-compatible endpoint) ───────────────────────────
# Ollama serves qwen3.5:2b on its built-in OpenAI-compatible API.
# ChatOpenAI is pointed at that endpoint via VLLM_BASE_URL.
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_NAME=qwen3.5:2b
OPENAI_API_KEY=ollama          # Ollama ignores the key; any non-empty string works

# ── Qdrant vector store ───────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents
QDRANT_PORT=6333
SERVER_HOST=localhost
EMBEDDING_PORT=8080

# ── Web search (Exa MCP) ──────────────────────────────────────────────────────
# SMITHERY_EXA_URL=
# EXA_MCP_API_KEY=
# EXA_MCP_PROFILE=

# ── Google Search (fallback web_search_tool) ──────────────────────────────────
# GOOGLE_CUSTOM_SEARCH_API=

# ── Google Generative AI (ExtractorAgent uses Gemini by default) ──────────────
# Set GOOGLE_API_KEY if you want to use Gemini for extraction, otherwise leave
# blank and ExtractorAgent will fall back to the Ollama endpoint.
# GOOGLE_API_KEY=
